# Server-side only. These are read by the Netlify Functions in
# netlify/functions/ and are NEVER bundled into the browser.
#
# Do not prefix these with VITE_ — that would expose them to every visitor.
# Set the same two values in Netlify: Site settings > Environment variables.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
